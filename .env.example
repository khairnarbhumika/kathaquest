# PostgreSQL connection string (Optional; if omitted, falls back to embedded WASM PGlite)
DATABASE_URL=

# Google Gemini API Key (Optional fallback supported)
GEMINI_API_KEY=

# Model configuration
GEMINI_MODEL=gemini-2.5-flash

# Security secret for hashing session tokens
SESSION_TOKEN_PEPPER=super-secret-cryptographic-pepper-string-kathaquest-2026

# Server configuration
PORT=5000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
